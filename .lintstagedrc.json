{
  "packages/backend/**/*.{js,ts}": [
    "node packages/backend/node_modules/eslint/bin/eslint.js --config packages/backend/eslint.config.js --fix",
    "prettier --write",
    "jest --bail --findRelatedTests --passWithNoTests"
  ],
  "packages/frontend/**/*.{js,jsx,ts,tsx}": [
    "node packages/frontend/node_modules/eslint/bin/eslint.js --config packages/frontend/eslint.config.js --fix",
    "prettier --write",
    "jest --bail --findRelatedTests --passWithNoTests"
  ],
  "*.{js,ts}": ["prettier --write"],
  "*.{json,md,css}": ["prettier --write"]
}
